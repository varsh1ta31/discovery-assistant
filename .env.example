# Copy to .env and fill in. Both files are gitignored.

# Postgres connection string for the EKB.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/personal_discovery_agent

# Anthropic API key, read by src/lib/model/claude.ts.
# Conventionally kept in .env.local rather than .env.
ANTHROPIC_API_KEY=sk-ant-...
